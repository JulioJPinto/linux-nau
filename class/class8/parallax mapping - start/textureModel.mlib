<?xml version="1.0" ?>
<materialLib name="Texture">

	<textures>
        <texture name="HM" filename="textures/Tiles/hm.jpg" mipmap="true" />
        <texture name="NM" filename="textures/Tiles/nm.jpg" mipmap="true" />
        <texture name="diffuse" filename="textures/Tiles/diffuse.jpg" mipmap="true" />
		
	</textures>

	<shaders>
		<shader name="textured" 	    vs = "shaders/texture.vert" 
									    ps = "shaders/texture.frag" />
		<shader name="texturedTS" 		vs = "shaders/textureTS.vert" 
										ps = "shaders/textureTS.frag" />
		<shader name="parallax" 		vs = "shaders/parallax.vert" 
										ps = "shaders/parallax.frag" />
		<shader name="steepParallax" 	vs = "shaders/steepParallax.vert" 
										ps = "shaders/steepParallax.frag" />
	</shaders>
	
    <materials>
        <material name="textured">
            <shader name="textured">
                <values>
                    <valueof uniform="m_pvm" 
                                type="RENDERER" context="CURRENT" 
                                component="PROJECTION_VIEW_MODEL" />
                                    
                    <valueof uniform="m_viewModel" 
                                type="RENDERER" context="CURRENT" 
                                component="VIEW_MODEL" />
                        
                    <valueof uniform="m_view" 
                                type="RENDERER" context="CURRENT" 
                                component="VIEW" />
                        
                    <valueof uniform="m_normal" 
                                type="RENDERER" context="CURRENT" 
                                component="NORMAL" />
                        
                    <valueof uniform="l_dir"
                                type="LIGHT" context="CURRENT" 
                                component="DIRECTION" id="0"/>
                        
                    <valueof uniform="diffuse"
                                type="TEXTURE_BINDING" context="CURRENT"
                                component="UNIT" id="0" />
                                

                    </values>
            </shader>
            <textures>
                <texture name="diffuse" UNIT = "0" />
            </textures>
        </material>

		<material name="texturedTS">
			<shader name="texturedTS">
				<values>
					<valueof uniform="m_pvm" 
							 type="RENDERER" context="CURRENT" 
							 component="PROJECTION_VIEW_MODEL" />
					 			 
					<valueof uniform="m_viewModel" 
							 type="RENDERER" context="CURRENT" 
							 component="VIEW_MODEL" />
					 
					<valueof uniform="m_view" 
							 type="RENDERER" context="CURRENT" 
							 component="VIEW" />
					 
					<valueof uniform="m_normal" 
							 type="RENDERER" context="CURRENT" 
							 component="NORMAL" />
					 
					<valueof uniform="l_dir"
							 type="LIGHT" context="CURRENT" 
							 component="DIRECTION" id="0"/>
					 
					<valueof uniform="diffuse"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="0" />

					<valueof uniform="normalMap"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="1" />

				 </values>
			</shader>
			<textures>
				<texture name="diffuse" UNIT = "0" />
				<texture name="NM" UNIT = "1" />
			</textures>
		</material>

		<material name="parallax">
			<shader name="parallax">
				<values>
					<valueof uniform="m_pvm" 
							 type="RENDERER" context="CURRENT" 
							 component="PROJECTION_VIEW_MODEL" />
					 			 
					<valueof uniform="m_viewModel" 
							 type="RENDERER" context="CURRENT" 
							 component="VIEW_MODEL" />
					 
					<valueof uniform="m_view" 
							 type="RENDERER" context="CURRENT" 
							 component="VIEW" />
					 
					<valueof uniform="m_normal" 
							 type="RENDERER" context="CURRENT" 
							 component="NORMAL" />
					 
					<valueof uniform="l_dir"
							 type="LIGHT" context="CURRENT" 
							 component="DIRECTION" id="0"/>
					 
					<valueof uniform="diffuse"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="0" />

					<valueof uniform="normalMap"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="1" />

                    <valueof uniform="heightMap"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="2" />

					<valueof uniform="scale" 
							 type="COLOR" context="CURRENT" 
							 component="scale" />
					 
					<valueof uniform="bias" 
							 type="COLOR" context="CURRENT" 
							 component="bias" />
					 
				 </values>
			</shader>
			<textures>
				<texture name="diffuse" UNIT = "0" />
				<texture name="NM" UNIT = "1" />
				<texture name="HM" UNIT = "2" />
			</textures>
		</material>

		<material name="steepParallax">
			<shader name="steepParallax">
				<values>
					<valueof uniform="m_pvm" 
							 type="RENDERER" context="CURRENT" 
							 component="PROJECTION_VIEW_MODEL" />
					 			 
					<valueof uniform="m_viewModel" 
							 type="RENDERER" context="CURRENT" 
							 component="VIEW_MODEL" />
					 
					<valueof uniform="m_view" 
							 type="RENDERER" context="CURRENT" 
							 component="VIEW" />
					 
					<valueof uniform="m_normal" 
							 type="RENDERER" context="CURRENT" 
							 component="NORMAL" />
					 
					<valueof uniform="l_dir"
							 type="LIGHT" context="CURRENT" 
							 component="DIRECTION" id="0"/>
					 
					<valueof uniform="diffuse"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="0" />

					<valueof uniform="normalMap"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="1" />

                    <valueof uniform="heightMap"
							 type="TEXTURE_BINDING" context="CURRENT"
							 component="UNIT" id="2" />

					<valueof uniform="bumpScale" 
							 type="COLOR" context="CURRENT" 
							 component="bumpScale" />
					 
					<valueof uniform="linSteps" 
							 type="COLOR" context="CURRENT" 
							 component="linSteps" />
					 
					<valueof uniform="binSteps" 
							 type="COLOR" context="CURRENT" 
							 component="binSteps" />
					 
					<valueof uniform="shadowLinSteps" 
							 type="COLOR" context="CURRENT" 
							 component="shadowLinSteps" />
					 
					 
				 </values>
			</shader>
			<textures>
				<texture name="diffuse" UNIT = "0" />
				<texture name="NM" UNIT = "1" />
				<texture name="HM" UNIT = "2" />
			</textures>
		</material>

		
	</materials>
	
</materialLib>